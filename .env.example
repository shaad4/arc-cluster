# Reference only: export these variables or use systemd EnvironmentFile.
ARC_HOST=127.0.0.1
ARC_PORT=8000
ARC_RAY_PYTHON=/data/cluster/venv/bin/python
ARC_RAY_ADDRESS=100.118.85.127:6379
ARC_RAY_DASHBOARD=http://127.0.0.1:8265
ARC_POLL_INTERVAL=5
ARC_STALE_AFTER=20
ARC_BRIDGE_TIMEOUT=15
ARC_COLLECTOR_ENABLED=true
